# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@hostname:5432/furniro_db?schema=public"

# Application Port
PORT=8000

# Authentication (JWT)
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Allowed Frontend URLs for CORS (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:3000,https://your-frontend-app.vercel.app"
