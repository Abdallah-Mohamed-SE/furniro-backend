// Prisma v7 schema for Furniro backend
// URL is configured in prisma.config.ts, not here

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  phone     String?
  role      Role      @default(CUSTOMER)
  addresses Address[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  nameAr    String
  slug      String    @unique
  image     String?
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("categories")
}

model Product {
  id              String      @id @default(uuid())
  sku             String      @unique
  name            String
  nameAr          String
  slug            String      @unique
  subtitle        String
  subtitleAr      String
  description     String      @db.Text
  descriptionAr   String      @db.Text
  price           Float
  originalPrice   Float?
  discountPercent Int?
  isNew           Boolean     @default(false)
  stock           Int         @default(10)
  images          String[]
  sizes           String[]
  colors          String[]
  tags            String[]
  rating          Float       @default(4.5)
  reviewsCount    Int         @default(0)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@map("products")
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  company   String?
  country   String
  street    String
  city      String
  province  String
  zipCode   String
  phone     String
  email     String
  isDefault Boolean @default(false)

  @@index([userId])
  @@map("addresses")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(PENDING)
  paymentMethod   String
  subtotal        Float
  shipping        Float       @default(0)
  total           Float
  shippingAddress Json
  notes           String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int
  price         Float
  selectedSize  String?
  selectedColor String?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  titleAr     String
  slug        String   @unique
  excerpt     String   @db.Text
  excerptAr   String   @db.Text
  content     String   @db.Text
  contentAr   String   @db.Text
  image       String
  category    String
  categoryAr  String
  author      String   @default("Admin")
  publishedAt DateTime @default(now())

  @@index([slug])
  @@map("blog_posts")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
